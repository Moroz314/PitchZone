{
  "name": "@pitchzone/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main",
    "start:worker": "ts-node -r tsconfig-paths/register src/worker/main.ts",
    "start:worker:prod": "node dist/worker/main.js",
    "test:ea-api": "ts-node -r tsconfig-paths/register scripts/test-ea-api.ts",
    "seed:ea-poll": "ts-node -r tsconfig-paths/register scripts/seed-ea-poll.ts",
    "seed:last-dance": "ts-node prisma/seed-last-dance.ts",
    "seed:last-dance-ea-poll": "ts-node -r tsconfig-paths/register scripts/seed-last-dance-ea-poll.ts",
    "seed:ld-g7-poll": "ts-node -r tsconfig-paths/register scripts/seed-ld-g7-poll.ts",
    "seed:tournament-ea-test": "ts-node -r tsconfig-paths/register scripts/seed-tournament-ea-test.ts",
    "seed:demo-tournament": "ts-node -r tsconfig-paths/register scripts/seed-demo-tournament.ts",
    "test:fallback-e2e": "ts-node -r tsconfig-paths/register scripts/test-fallback-e2e.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "ts-node prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.0.11",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.11",
    "@nestjs/platform-socket.io": "^11.0.11",
    "@nestjs/websockets": "^11.0.11",
    "@prisma/client": "^6.5.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.81.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "decimal.js": "^10.6.0",
    "ioredis": "^5.11.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@pitchzone/config": "*",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^9.22.0",
    "prisma": "^6.5.0",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2"
  }
}
