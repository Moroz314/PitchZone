# =============================================================================
# PitchZone — Production Environment Variables
# Railway will inject some of these automatically, but you must configure others.
# =============================================================================

# --- Application ---
NODE_ENV=production
# PORT is automatically injected by Railway
# PORT=3001
# Replace with your actual frontend domain
CORS_ORIGIN=https://your-frontend-domain.up.railway.app
# Replace with your actual API domain
NEXT_PUBLIC_API_URL=https://your-api-domain.up.railway.app/api
NEXT_PUBLIC_WS_URL=https://your-api-domain.up.railway.app

# --- PostgreSQL (Neon) ---
# Use the Connection String from Neon Dashboard.
# MUST end with ?sslmode=require for secure connection.
# DATABASE_URL=postgresql://user:password@ep-...neon.tech/dbname?sslmode=require

# --- Redis (Upstash) ---
# Use the `rediss://...` connection string from Upstash Dashboard.
# REDIS_URL=rediss://default:password@...upstash.io:6379

# --- Auth ---
# Generate a strong 32+ character random string for production
JWT_SECRET=YOUR_VERY_STRONG_JWT_SECRET
# Frontend domain
NEXTAUTH_URL=https://your-frontend-domain.up.railway.app
# Must match JWT_SECRET or be another strong 32+ char string
NEXTAUTH_SECRET=YOUR_VERY_STRONG_NEXTAUTH_SECRET
# Same as API URL but without /api
STEAM_REALM=https://your-api-domain.up.railway.app

# Discord OAuth (Required for production login)
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Steam API key (Required for avatar syncing)
STEAM_API_KEY=your_steam_api_key

# --- Stripe (Optional for staging if using mock payments) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_MOCK=true
WITHDRAWALS_MOCK=true

# --- Object Storage (Optional for staging) ---
# If empty, uploads are stored locally in the container (NOTE: Railway containers are ephemeral!
# Any file uploaded locally WILL BE DELETED on the next deploy.
# For production/staging, you MUST set up an S3 bucket (AWS, Cloudflare R2, DigitalOcean Spaces, etc.))
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=pitchzone-uploads
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
# Public URL to access uploaded files
STORAGE_PUBLIC_URL=https://your-api-domain.up.railway.app/api/uploads
