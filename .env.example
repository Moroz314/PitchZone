# =============================================================================
# PitchZone — Environment Variables
# Copy this file to .env and adjust values for local development
# =============================================================================

# --- Application ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=http://localhost:4000

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pitchzone
POSTGRES_PASSWORD=pitchzone_dev
POSTGRES_DB=pitchzone
DATABASE_URL=postgresql://pitchzone:pitchzone_dev@localhost:5432/pitchzone

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=change-me-to-a-random-secret-min-32-chars
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-random-secret-min-32-chars
STEAM_REALM=http://localhost:4000

# Discord OAuth (optional — create app at https://discord.com/developers)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Steam API key (optional — for fetching player names/avatars)
STEAM_API_KEY=

# --- Stripe (Stage 5 — tournament entry fees) ---
# Leave STRIPE_SECRET_KEY empty to use mock payments in development
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# PAYMENTS_MOCK=true forces mock checkout even if Stripe keys are set
PAYMENTS_MOCK=true

# --- Withdrawals (Stage 10 — wallet payouts) ---
# WITHDRAWALS_MOCK=true uses instant mock payout processing (default when Stripe is off)
WITHDRAWALS_MOCK=true

# --- Email — placeholders for future stages ---
# RESEND_API_KEY=
# EMAIL_FROM=noreply@pitchzone.gg

# --- Object Storage (Stage 7 — match proofs) ---
# Leave S3_ENDPOINT empty to store uploads locally at apps/api/uploads/
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=pitchzone-uploads
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
# Public URL for local dev (default serves /api/uploads/)
STORAGE_PUBLIC_URL=http://localhost:4000/api/uploads

# --- Monitoring — placeholders for future stages ---
# SENTRY_DSN=
